{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "release": {
    "projects": [
      "packages/*"
    ],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "currentVersionResolverMetadata": {
        "registry": "https://registry.npmjs.org/"
      },
      "updateDependents": "auto",
      "preserveMatchingDependencyRanges": false
    },
    "releaseTagPattern": "{projectName}@{version}",
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github",
        "renderOptions": {
          "authors": false
        }
      }
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): publish {version}",
      "tag": true
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "✨ Features",
            "hidden": false
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "🐛 Bug Fixes",
            "hidden": false
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "title": "🚀 Performance Improvements",
            "hidden": false
          }
        },
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "title": "📦 Code Refactoring",
            "hidden": false
          }
        },
        "docs": {
          "semverBump": "none",
          "changelog": {
            "title": "📝 Documentation",
            "hidden": false
          }
        },
        "build": {
          "semverBump": "none",
          "changelog": {
            "title": "🏗️ Build System",
            "hidden": false
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "title": "🧪 Tests",
            "hidden": false
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": {
            "title": "🔧 Continuous Integration",
            "hidden": true
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": {
            "title": "🔧 Chores",
            "hidden": true
          }
        },
        "style": {
          "semverBump": "none",
          "changelog": {
            "title": "💄 Styles",
            "hidden": true
          }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": {
            "title": "⏪️ Reverts",
            "hidden": false
          }
        }
      }
    }
  },
  "analytics": false
}