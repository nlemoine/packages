{
    "name": "@n5s/bruno-wordpress-converter",
    "version": "2.0.0",
    "description": "Convert WordPress REST API to Bruno collection format with beautiful interactive CLI",
    "keywords": [
        "bruno",
        "usebruno",
        "opencollection",
        "wordpress",
        "rest-api",
        "converter",
        "wp-json",
        "api-client",
        "api",
        "cli",
        "tool",
        "wordpress-api",
        "bruno-collection"
    ],
    "homepage": "https://github.com/nlemoine/packages/tree/main/packages/bruno-wordpress-converter#readme",
    "bugs": {
        "url": "https://github.com/nlemoine/packages/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nlemoine/packages.git",
        "directory": "packages/bruno-wordpress-converter"
    },
    "license": "MIT",
    "author": {
        "name": "Nicolas Lemoine",
        "email": "nico@n5s.dev",
        "url": "https://github.com/nlemoine"
    },
    "type": "module",
    "exports": {
        ".": "./src/index.js",
        "./package.json": "./package.json"
    },
    "main": "src/index.js",
    "bin": {
        "wp-to-bruno": "src/cli.js"
    },
    "files": [
        "src/**/*",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "format": "biome format --write",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "prepublishOnly": "pnpm run lint && publint",
        "start": "node src/cli.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@clack/prompts": "^1.4.0",
        "@sindresorhus/slugify": "^3.0.0",
        "https-proxy-agent": "^9.0.0",
        "js-yaml": "^4.1.1",
        "node-fetch": "^3.3.2",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "vitest": "^4.1.7"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
