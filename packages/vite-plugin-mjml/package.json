{
  "name": "@n5s/vite-plugin-mjml",
  "version": "0.1.0",
  "description": "Vite plugin that compiles MJML email templates to HTML with a live dev preview",
  "keywords": [
    "vite",
    "vite-plugin",
    "mjml",
    "email",
    "html-email",
    "email-templates",
    "preview",
    "preact"
  ],
  "homepage": "https://github.com/nlemoine/packages/tree/main/packages/vite-plugin-mjml#readme",
  "bugs": {
    "url": "https://github.com/nlemoine/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nlemoine/packages.git",
    "directory": "packages/vite-plugin-mjml"
  },
  "license": "MIT",
  "author": {
    "name": "Nicolas Lemoine",
    "email": "nico@n5s.dev",
    "url": "https://github.com/nlemoine"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && vite build src/client",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepublishOnly": "pnpm run build && publint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@email-lint/core": "^0.2.1",
    "glob": "^13.0.1",
    "mjml": "^4.18.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3",
    "sirv": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@preact/signals": "^2.7.0",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.5",
    "preact": "^10.28.3",
    "prismjs": "^1.30.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "unocss": "^66.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
