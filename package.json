{
  "name": "@n5s/packages",
  "version": "0.0.0",
  "private": true,
  "description": "n5s JS packages monorepo",
  "license": "MIT",
  "author": "n5s",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run knip && pnpm run publint",
    "format": "nx run-many -t format",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "normalize": "sort-package-json \"package.json\" \"packages/*/package.json\"",
    "publint": "pnpm -r --no-bail exec publint",
    "release": "nx release",
    "release:publish": "nx release publish",
    "release:version": "nx release version",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@nx/js": "23.1.1",
    "knip": "^6.32.2",
    "nx": "23.1.1",
    "publint": "^0.3.24",
    "sort-package-json": "^4.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
